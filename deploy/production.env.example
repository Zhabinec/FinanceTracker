# Copy to .env.production at the repository root. Never commit filled values.
# Use independent random secrets; a hex database password avoids connection string delimiters.
APP_VERSION=2026-10-26.1
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
PUBLIC_URL=https://finance.example.com
EMAIL_FROM=Finance Tracker <finance@example.com>
EMAIL_API_KEY=
# Absolute path on the deployment host, readable by nginx. Requires trusted certificates.
TLS_CERT_DIR=/opt/finance/certs
