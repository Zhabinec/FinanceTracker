# Generate a local signing key with scripts/init-local.ps1. Do not commit .env.
JWT_SIGNING_KEY=
FRONTEND_PORT=5180
# Optional for Docker; local dotnet development uses scripts/configure-telegram.ps1.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=PetProjectFinanceBot
TELEGRAM_ONLY=true
MANAGED_FINANCIAL_KEYS=true
SERVER_FINANCIAL_RECORDS=true
# Independent random 32-byte key encoded as Base64. Keep it across restarts.
FINANCIAL_WRAPPING_KEY=
